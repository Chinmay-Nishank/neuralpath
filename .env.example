# NeuralPath Environment Variables
# Copy to .env.local for local development.
# All optional features degrade gracefully when omitted.

# Public Site URL (used for metadata, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO=https://github.com/neuralpath/neuralpath

# Optional AI Tutor (Groq API — server-side only, never exposed to client)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Authentication (NextAuth v5 / Auth.js)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional PostgreSQL Database (Prisma cross-device progress sync)
# When omitted, NeuralPath stores all progress, streaks, notes, and bookmarks locally in localStorage.
DATABASE_URL=

# Optional Privacy-Friendly Analytics (cookie-consent aware)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

